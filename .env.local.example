# ---- Supabase (project URL + keys) ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# ---- Access control ----
# Comma-separated emails allowed to sign in. Anyone else gets rejected.
ALLOWED_EMAILS=you@example.com,teammate@example.com

# ---- N8N integration ----
# Long random secret. N8N must send `Authorization: Bearer <this>` to /api/ingest.
INGEST_TOKEN=replace-with-a-long-random-string

# Webhook URL that triggers the "DreamMe Daily Content Pipeline (3 Personas)" workflow.
# Get it from the Webhook trigger node in N8N (Production URL).
N8N_TRIGGER_WEBHOOK_URL=https://conquerable-rowan-supergloriously.ngrok-free.dev/webhook/REPLACE

# Base URL of this Next.js app (used in magic-link emails + redirects).
NEXT_PUBLIC_APP_URL=http://localhost:3000
