# ---- Supabase (project URL + keys) ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
NEXT_PUBLIC_SUPABASE_BUCKET=dreamme-admin-internal-images

# Server-only. Used by /api/ingest/content-pipeline to upload images and
# insert rows; do NOT expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# ---- n8n ingest auth ----
# Shared secret. n8n must send either:
#   X-DreamMe-Secret: <this>
#   or Authorization: Bearer <this>
# Generate a long random string.
INGEST_TOKEN=replace-with-a-long-random-string

# ---- Hook Analytics ----
# Apify TikTok scraper token. Get one at https://console.apify.com/account/integrations
APIFY_KEY=apify_api_xxxxxxxxxxxxxxxx
# (optional) override the Apify actor. Default: clockworks~tiktok-scraper
# APIFY_TIKTOK_ACTOR_ID=clockworks~tiktok-scraper

# Claude API key for OCR, categorization, and hook generation.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx

# Shared secret for Vercel Cron. Vercel automatically sends this as
# Authorization: Bearer <CRON_SECRET> to /api/cron/* when this var is set.
CRON_SECRET=replace-with-a-long-random-string

# ---- RevenueCat (Creatives dashboard "money made" surface) ----
# v2 secret API key with read scope. Generate at:
# https://app.revenuecat.com/projects/<project>/api-keys
REVENUECAT_API_KEY=sk_xxxxxxxxxxxxxxxx
# DreamMe production project — do not change unless RC project changes.
REVENUECAT_PROJECT_ID=projc9e74a6c

# ---- Meta Ads (insights sync, audience refresh, Ads MCP) ----
# Long-lived / system-user token. Needs `ads_read`; also `ads_management` for
# the Ads MCP write tools (pause/budget). Document the expiry — code surfaces a
# clear error on Meta code 190 when it lapses.
META_ACCESS_TOKEN=replace-with-meta-access-token
META_AD_ACCOUNT_ID=act_1575502753719515
# Optional — defaults to v22.0 if unset.
# META_API_VERSION=v22.0

# ---- DreamMe Ads MCP ----
# Shared bearer secret. Every request to /api/ads-mcp/mcp must send
# Authorization: Bearer <this>. The endpoint fails closed if this is unset.
# Generate a long random string; set it here AND in the Claude .mcp.json.
MCP_TOKEN=replace-with-a-long-random-string

# ---- Meta "Login with Facebook" OAuth (Integrations panel) ----
# From your Facebook App (App Dashboard → Settings → Basic). The app needs the
# "Facebook Login" product with Valid OAuth Redirect URIs set to:
#   http://localhost:3000/api/oauth/meta/callback   (dev)
#   https://<your-dash-domain>/api/oauth/meta/callback (prod)
META_OAUTH_APP_ID=replace-with-facebook-app-id
META_OAUTH_CLIENT_SECRET=replace-with-facebook-app-secret
# Random string used to sign the CSRF state cookie (falls back to the client
# secret if unset, but set a dedicated one).
META_OAUTH_STATE_SECRET=replace-with-a-long-random-string
# Optional — defaults to ads_read,ads_management,business_management.
# META_OAUTH_SCOPES=ads_read,ads_management,business_management

# Admin password gating the connect flow + Integrations status endpoints.
# Reuses the MCP OAuth admin password (defaults to "dreammeAdmin" if unset).
# MCP_OAUTH_ADMIN_PASSWORD=replace-with-a-strong-admin-password

# ---- TikTok Ads (Spark Ads dashboard surface) ----
# Marketing API access token. Generation steps: docs/tiktok-ads-api-setup.md
# Long-lived (~1 year); document expiry like META_ACCESS_TOKEN.
TIKTOK_ADS_ACCESS_TOKEN=replace-with-tiktok-marketing-api-token
# Advertiser ID — TikTok Ads Manager → Settings → Account
TIKTOK_ADVERTISER_ID=replace-with-advertiser-id
# Same advertiser_id exposed to the client so card "Open in TikTok Ads
# Manager" deep-links work. Safe to expose (it's already in the URL bar
# when you're in TikTok Ads Manager).
NEXT_PUBLIC_TIKTOK_ADVERTISER_ID=replace-with-advertiser-id

# ---- SynthID Research (internal only) ----
# Local Python service from services/synthid/ in the analytics repo.
# Use http://localhost:8000 in dev, hosted URL in prod.
SYNTHID_SERVICE_URL=http://localhost:8000
SYNTHID_SERVICE_TOKEN=replace-with-a-long-random-string
